{
  "name": "ge-workbench-robot-ops",
  "version": "0.3.3",
  "description": "高仙机器人助手：汇总各项目清洁机器人的在线、任务、面积与达标情况，可下钻到项目与单台设备",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/screenshots",
    "README.md",
    "LICENSE"
  ],
  "author": "颜政、张宸熙",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zcx-BaixiaoBai/ge-workbench-robot-ops"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0"
  },
  "scripts": {
    "build": "esbuild src/entry.jsx --bundle --format=iife --target=es2022 --outfile=lib/client.js --jsx-factory=h",
    "pretest": "esbuild src/panel.jsx --format=esm --outfile=test/.panel.mjs --jsx-factory=h",
    "test": "node --test test/aggregate.test.mjs test/server.test.mjs test/client.test.mjs test/render.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  }
}
